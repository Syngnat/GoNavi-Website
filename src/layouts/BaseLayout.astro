---
import '../styles/tokens.css';
import '../styles/global.css';
import '../styles/layout.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import type { Locale } from '../lib/i18n';
import { GITHUB_URL, stripLocale, withLocale } from '../lib/i18n';
import { isAnalyticsEnabled } from '../lib/analytics';

interface Props {
  locale: Locale;
  title?: string;
  description?: string;
  /** e.g. '/download' */
  current?: string;
  article?: {
    section: string;
  };
}

const { locale, title, description, current = '/', article } = Astro.props;
const siteTitle = title ? `${title} · GoNavi` : 'GoNavi — Navigate every data source';
const siteUrl = Astro.site ?? new URL('http://localhost:4173');
const canonical = new URL(Astro.url.pathname, siteUrl);
const routePath = stripLocale(Astro.url.pathname);
const normalizedRoutePath = routePath === '/' ? '/' : routePath.replace(/\/+$/, '');
const zhAlternate = new URL(withLocale('zh', routePath), siteUrl);
const enAlternate = new URL(withLocale('en', routePath), siteUrl);
const socialImage = new URL('/screenshots/01-home-workbench.png', siteUrl);
const localeTag = locale === 'zh' ? 'zh_CN' : 'en_US';
const alternateLocaleTag = locale === 'zh' ? 'en_US' : 'zh_CN';
const socialImageAlt = locale === 'zh' ? 'GoNavi 数据库工作台界面' : 'GoNavi database workbench interface';
const language = locale === 'zh' ? 'zh-CN' : 'en-US';
const homeUrl = new URL(withLocale(locale, '/'), siteUrl);
const docsUrl = new URL(withLocale(locale, '/docs'), siteUrl);
const routeLabels: Record<string, string> = {
  '/download': locale === 'zh' ? '下载' : 'Download',
  '/docs': locale === 'zh' ? '文档' : 'Docs',
  '/changelog': locale === 'zh' ? '更新日志' : 'Changelog',
  '/roadmap': locale === 'zh' ? '路线图' : 'Roadmap',
};
const breadcrumbItems: { name: string; item: string }[] = [{ name: 'GoNavi', item: homeUrl.href }];
if (normalizedRoutePath.startsWith('/docs/')) {
  breadcrumbItems.push(
    { name: routeLabels['/docs'], item: docsUrl.href },
    { name: title ?? 'Docs', item: canonical.href },
  );
} else if (normalizedRoutePath !== '/') {
  breadcrumbItems.push({
    name: routeLabels[normalizedRoutePath] ?? title ?? normalizedRoutePath,
    item: canonical.href,
  });
}
const breadcrumbId = `${canonical.href}#breadcrumb`;
const articleId = `${canonical.href}#article`;
const softwareId = `${canonical.href}#software`;
const structuredData = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': new URL('/#organization', siteUrl).href,
      name: 'GoNavi',
      url: new URL('/', siteUrl).href,
      logo: new URL('/logo.webp', siteUrl).href,
      sameAs: [GITHUB_URL],
    },
    {
      '@type': 'WebSite',
      '@id': new URL('/#website', siteUrl).href,
      name: 'GoNavi',
      url: new URL('/', siteUrl).href,
      publisher: { '@id': new URL('/#organization', siteUrl).href },
      inLanguage: ['zh-CN', 'en-US'],
    },
    {
      '@type': 'WebPage',
      '@id': canonical.href,
      name: siteTitle,
      url: canonical.href,
      description,
      inLanguage: language,
      isPartOf: { '@id': new URL('/#website', siteUrl).href },
      breadcrumb: { '@id': breadcrumbId },
      ...(current === '/' ? { mainEntity: { '@id': softwareId } } : {}),
      ...(article ? { mainEntity: { '@id': articleId } } : {}),
    },
    ...(current === '/' ? [{
      '@type': 'SoftwareApplication',
      '@id': softwareId,
      name: 'GoNavi',
      applicationCategory: 'DeveloperApplication',
      applicationSubCategory: 'Database Management Software',
      description,
      url: canonical.href,
      image: socialImage.href,
      operatingSystem: 'Windows, macOS, Linux',
      featureList: locale === 'zh'
        ? ['30+ 数据源', '原生桌面工作台', 'SQL 查询与结果比对', 'AI 助手']
        : ['30+ data sources', 'Native desktop workbench', 'SQL queries and result comparison', 'AI assistant'],
      inLanguage: language,
      publisher: { '@id': new URL('/#organization', siteUrl).href },
    }] : []),
    ...(article ? [{
      '@type': 'TechArticle',
      '@id': articleId,
      headline: title,
      description,
      url: canonical.href,
      image: socialImage.href,
      inLanguage: language,
      articleSection: article.section,
      author: { '@id': new URL('/#organization', siteUrl).href },
      publisher: { '@id': new URL('/#organization', siteUrl).href },
      isPartOf: { '@id': new URL('/#website', siteUrl).href },
      mainEntityOfPage: { '@id': canonical.href },
    }] : []),
    {
      '@type': 'BreadcrumbList',
      '@id': breadcrumbId,
      itemListElement: breadcrumbItems.map((item, position) => ({
        '@type': 'ListItem',
        position: position + 1,
        name: item.name,
        item: item.item,
      })),
    },
  ],
}).replace(/</g, '\\u003c');
---
<!doctype html>
<html lang={locale === 'zh' ? 'zh-CN' : 'en-US'}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>{siteTitle}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="zh-CN" href={zhAlternate} />
    <link rel="alternate" hreflang="en-US" href={enAlternate} />
    <link rel="alternate" hreflang="x-default" href={zhAlternate} />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
    <link rel="icon" type="image/webp" href="/logo.webp?v=20260731" sizes="512x512" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="GoNavi" />
    <meta property="og:locale" content={localeTag} />
    <meta property="og:locale:alternate" content={alternateLocaleTag} />
    <meta property="og:title" content={siteTitle} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1440" />
    <meta property="og:image:height" content="900" />
    <meta property="og:image:alt" content={socialImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={siteTitle} />
    {description && <meta name="twitter:description" content={description} />}
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={socialImageAlt} />
    <script type="application/ld+json" set:html={structuredData}></script>
    {isAnalyticsEnabled && (
      <script>
        import { trackPageView } from '../lib/analytics-client';

        trackPageView();
      </script>
    )}
  </head>
  <body>
    <div class="site-shell">
      <SiteHeader locale={locale} current={current} />
      <main class="site-main">
        <slot />
      </main>
      <SiteFooter locale={locale} />
    </div>
  </body>
</html>
