---
import BaseLayout from '../../layouts/BaseLayout.astro';
// After BaseLayout, so these rules come later in the cascade than the shared stylesheets.
import '../../styles/home.css';
import Hero from '../../components/Hero.astro';
import SponsorBanner from '../../components/SponsorBanner.astro';
import Scorecard from '../../components/Scorecard.astro';
import Capabilities from '../../components/Capabilities.astro';
import AgentsSection from '../../components/AgentsSection.astro';
import DataSources from '../../components/DataSources.astro';
import CTASection from '../../components/CTASection.astro';
import { getEntry } from 'astro:content';
import type { Locale } from '../../lib/i18n';

interface Props {
  locale: Locale;
}

export function getStaticPaths() {
  return [
    { params: { locale: 'zh' }, props: { locale: 'zh' } },
    { params: { locale: 'en' }, props: { locale: 'en' } },
  ];
}

const { locale } = Astro.props;
const entry = await getEntry('site', locale);
if (!entry) {
  throw new Error(`Missing site content for locale: ${locale}`);
}

const data = entry.data;
---
<BaseLayout locale={locale} title={data.title} description={data.description} current="/">
  <Hero locale={locale} hero={data.hero} tour={data.tour} />
  <SponsorBanner locale={locale} />
  <DataSources locale={locale} heading={data.sources} rows={data.databases} />
  <Scorecard locale={locale} data={data.scorecard} />
  <Capabilities data={data.capabilities} />
  <AgentsSection locale={locale} data={data.agents} />
  <CTASection locale={locale} data={data.cta} />
</BaseLayout>
