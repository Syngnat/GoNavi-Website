---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { withLocale } from '../../../lib/i18n';
import type { Locale } from '../../../lib/i18n';

export function getStaticPaths() {
  return [
    { params: { locale: 'zh' }, props: { locale: 'zh' } },
    { params: { locale: 'en' }, props: { locale: 'en' } },
  ];
}

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const isZh = locale === 'zh';

const posts = (await getCollection('blog'))
  .filter((d) => d.data.locale === locale)
  .sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));

const formatDate = (value: string) => {
  const date = new Date(`${value}T00:00:00`);
  return date.toLocaleDateString(isZh ? 'zh-CN' : 'en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
};

const copy = {
  title: isZh ? '博客' : 'Blog',
  description: isZh
    ? 'GoNavi 产品博客：数据库客户端选型、轻量原生工具对比，以及 AI 写 SQL 后 GUI 仍不可少的实践观点。'
    : 'GoNavi product blog on database client choices, lightweight native tools, and why a GUI still matters after AI can write SQL.',
  eyebrow: isZh ? '产品博客' : 'Product blog',
  readMore: isZh ? '阅读全文' : 'Read more',
};
---
<BaseLayout locale={locale} title={copy.title} description={copy.description} current="/blog">
  <div class="site-shell__inner page-wrap blog-index">
    <header class="blog-index__hero">
      <p class="blog-index__eyebrow">{copy.eyebrow}</p>
      <h1 class="blog-index__title">{copy.title}</h1>
      <p class="blog-index__lede">{copy.description}</p>
    </header>

    <div class="blog-index__grid">
      {posts.map((post) => (
        <a class="blog-index__card" href={withLocale(locale, `/blog/${post.data.slug}`)}>
          <time class="blog-index__date" datetime={post.data.date}>{formatDate(post.data.date)}</time>
          <h2 class="blog-index__card-title">{post.data.title}</h2>
          {post.data.summary && <p class="blog-index__summary">{post.data.summary}</p>}
          <span class="blog-index__more">
            {copy.readMore}
            <span class="blog-index__more-arrow" aria-hidden="true">→</span>
          </span>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>
