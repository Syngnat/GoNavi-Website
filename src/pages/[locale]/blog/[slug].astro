---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import { withLocale } from '../../../lib/i18n';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { locale: post.data.locale, slug: post.data.slug },
  }));
}

const { locale, slug } = Astro.params as { locale: 'zh' | 'en'; slug: string };
const [post] = (await getCollection('blog'))
  .filter((d) => d.data.locale === locale && d.data.slug === slug);
if (!post) throw new Error(`Blog post not found: ${locale}/${slug}`);
const { Content, headings } = await render(post);

const all = (await getCollection('blog'))
  .filter((d) => d.data.locale === locale)
  .sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));

const index = all.findIndex((d) => d.data.slug === slug);
const prev = index > 0 ? all[index - 1] : null;
const next = index >= 0 && index < all.length - 1 ? all[index + 1] : null;
const toc = headings.filter((h) => h.depth === 2);

const isZh = locale === 'zh';
const formatDate = (value: string) => {
  const date = new Date(`${value}T00:00:00`);
  return date.toLocaleDateString(isZh ? 'zh-CN' : 'en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
};

const copy = {
  backToIndex: isZh ? '← 返回博客' : '← Back to blog',
  tocTitle: isZh ? '目录' : 'On this page',
  prev: isZh ? '上一篇' : 'Previous',
  next: isZh ? '下一篇' : 'Next',
};
---
<BaseLayout
  locale={locale}
  title={post.data.title}
  description={post.data.summary}
  current={`/blog/${slug}`}
  article={{ section: locale === 'zh' ? 'GoNavi 博客' : 'GoNavi Blog' }}
>
  <div class="site-shell__inner page-wrap blog-post">
    <article class="blog-article">
      <a class="blog-article__back" href={withLocale(locale, '/blog')}>{copy.backToIndex}</a>

      <header class="blog-article__header">
        <time class="blog-article__date" datetime={post.data.date}>{formatDate(post.data.date)}</time>
        <h1 class="blog-article__title">{post.data.title}</h1>
        {post.data.summary && <p class="blog-article__summary">{post.data.summary}</p>}
      </header>

      {toc.length > 0 && (
        <nav class="blog-article__toc" aria-label={copy.tocTitle} data-blog-toc>
          <button
            type="button"
            class="blog-article__toc-toggle"
            data-blog-toc-toggle
            aria-expanded="true"
            aria-controls="blog-article-toc-list"
          >
            <span class="blog-article__toc-title">{copy.tocTitle}</span>
            <svg class="blog-article__toc-chevron" width="14" height="14" viewBox="0 0 12 12" aria-hidden="true">
              <path d="M2.5 4.5 6 8l3.5-3.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
          <ol class="blog-article__toc-list" id="blog-article-toc-list" data-blog-toc-list>
            {toc.map((item) => (
              <li>
                <a href={`#${item.slug}`}>{item.text}</a>
              </li>
            ))}
          </ol>
        </nav>
      )}

      <div class="blog-article__body">
        <Content />
      </div>

      {(prev || next) && (
        <nav class="blog-pager" aria-label={isZh ? '相关文章' : 'Related posts'}>
          {prev ? (
            <a class="blog-pager__item blog-pager__item--prev" href={withLocale(locale, `/blog/${prev.data.slug}`)}>
              <span class="blog-pager__label">{copy.prev}</span>
              <span class="blog-pager__title">{prev.data.title}</span>
            </a>
          ) : <span class="blog-pager__item blog-pager__item--placeholder" />}
          {next ? (
            <a class="blog-pager__item blog-pager__item--next" href={withLocale(locale, `/blog/${next.data.slug}`)}>
              <span class="blog-pager__label">{copy.next}</span>
              <span class="blog-pager__title">{next.data.title}</span>
            </a>
          ) : <span class="blog-pager__item blog-pager__item--placeholder" />}
        </nav>
      )}
    </article>
  </div>

      <script>
        function initBlogToc(root: ParentNode = document) {
          const mql = window.matchMedia('(max-width: 768px)');
          root.querySelectorAll<HTMLElement>('[data-blog-toc]').forEach((nav) => {
            const btn = nav.querySelector<HTMLButtonElement>('[data-blog-toc-toggle]');
            const list = nav.querySelector<HTMLElement>('[data-blog-toc-list]');
            if (!btn || !list) return;

            const apply = (collapsed: boolean) => {
              btn.setAttribute('aria-expanded', collapsed ? 'false' : 'true');
              nav.classList.toggle('blog-article__toc--collapsed', collapsed);
              list.hidden = collapsed;
            };

            const sync = () => {
              // Mobile: collapsed by default; desktop stays open.
              apply(mql.matches);
            };

            if (nav.dataset.tocReady !== '1') {
              nav.dataset.tocReady = '1';
              btn.addEventListener('click', () => {
                if (!mql.matches) return; // desktop toggle not needed
                const open = btn.getAttribute('aria-expanded') === 'true';
                apply(open);
              });
              mql.addEventListener('change', sync);
            }
            sync();
          });
        }

        initBlogToc();
        document.addEventListener('astro:page-load', () => initBlogToc());
      </script>
</BaseLayout>
