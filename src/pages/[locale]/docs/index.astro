---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import DocsSearch from '../../../components/DocsSearch.astro';
import { getCollection } from 'astro:content';
import { withLocale } from '../../../lib/i18n';
import type { Locale } from '../../../lib/i18n';

export function getStaticPaths() {
  return [
    { params: { locale: 'zh' }, props: { locale: 'zh' } },
    { params: { locale: 'en' }, props: { locale: 'en' } },
  ];
}

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const isZh = locale === 'zh';

const docs = (await getCollection('docs'))
  .filter((d) => d.data.locale === locale)
  .sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));

const copy = {
  title: isZh ? '文档' : 'Docs',
  description: isZh ? '从安装到日常使用，按主题查找你需要的指南。' : 'Find guides for installation, configuration, and everyday use of GoNavi.',
  eyebrow: isZh ? '使用文档' : 'Documentation',
  readMore: isZh ? '阅读全文' : 'Read more',
};
---
<BaseLayout locale={locale} title={copy.title} description={copy.description} current="/docs">
  <div class="site-shell__inner page-wrap">
    <section class="content-panel">
      <p class="content-panel__eyebrow">{copy.eyebrow}</p>
      <h1 class="content-panel__title">{copy.title}</h1>
      <p class="content-panel__copy">{copy.description}</p>
    </section>

    <DocsSearch locale={locale} variant="standalone" />

    <div class="docs-index__grid docs-index__grid--standalone">
      {docs.map((doc, i) => (
        <a class="docs-index__card docs-index__card--boxed" href={withLocale(locale, `/docs/${doc.data.slug}`)}>
          <span class="docs-index__card-index">{String(i + 1).padStart(2, '0')}</span>
          <div class="docs-index__card-main">
            <h2>{doc.data.title}</h2>
            {doc.data.summary && <p>{doc.data.summary}</p>}
          </div>
          <span class="docs-index__more">
            {copy.readMore}
            <span class="docs-index__more-arrow" aria-hidden="true">→</span>
          </span>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>
