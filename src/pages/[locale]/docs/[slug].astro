---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import { withLocale } from '../../../lib/i18n';

export async function getStaticPaths() {
  const docs = await getCollection('docs');
  return docs.map((doc) => ({
    params: { locale: doc.data.locale, slug: doc.data.slug },
  }));
}

const { locale, slug } = Astro.params as { locale: 'zh' | 'en'; slug: string };
const [doc] = (await getCollection('docs'))
  .filter((d) => d.data.locale === locale && d.data.slug === slug);
if (!doc) throw new Error(`Doc not found: ${locale}/${slug}`);
const { Content } = await render(doc);

const all = (await getCollection('docs'))
  .filter((d) => d.data.locale === locale)
  .sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));

const index = all.findIndex((d) => d.data.slug === slug);
const prev = index > 0 ? all[index - 1] : null;
const next = index >= 0 && index < all.length - 1 ? all[index + 1] : null;

const isZh = locale === 'zh';
const copy = {
  sidebarTitle: isZh ? '文档' : 'Docs',
  backToIndex: isZh ? '全部文档' : 'All docs',
  prev: isZh ? '上一篇' : 'Previous',
  next: isZh ? '下一篇' : 'Next',
};
---
<BaseLayout locale={locale} title={doc.data.title} description={doc.data.summary} current={`/docs/${slug}`}>
  <div class="site-shell__inner page-wrap">
    <div class="docs-layout">
      <aside class="docs-sidebar">
        <p class="docs-sidebar__title">{copy.sidebarTitle}</p>
        <nav class="docs-sidebar__nav">
          {all.map((d) => (
            <a
              class:list={['docs-sidebar__link', { 'docs-sidebar__link--active': d.data.slug === slug }]}
              href={withLocale(locale, `/docs/${d.data.slug}`)}
            >
              {d.data.title}
            </a>
          ))}
        </nav>
        <a class="docs-sidebar__back" href={withLocale(locale, '/docs')}>
          {copy.backToIndex}
        </a>
      </aside>

      <article class="docs-article">
        <header class="docs-article__header">
          <h1 class="docs-article__title">{doc.data.title}</h1>
          {doc.data.summary && <p class="docs-article__summary">{doc.data.summary}</p>}
        </header>
        <div class="docs-article__body">
          <Content />
        </div>

        {(prev || next) && (
          <nav class="docs-pager">
            {prev ? (
              <a class="docs-pager__item docs-pager__item--prev" href={withLocale(locale, `/docs/${prev.data.slug}`)}>
                <span class="docs-pager__label">{copy.prev}</span>
                <span class="docs-pager__title">{prev.data.title}</span>
              </a>
            ) : <span class="docs-pager__item docs-pager__item--placeholder" />}
            {next ? (
              <a class="docs-pager__item docs-pager__item--next" href={withLocale(locale, `/docs/${next.data.slug}`)}>
                <span class="docs-pager__label">{copy.next}</span>
                <span class="docs-pager__title">{next.data.title}</span>
              </a>
            ) : <span class="docs-pager__item docs-pager__item--placeholder" />}
          </nav>
        )}
      </article>
    </div>
  </div>
</BaseLayout>
