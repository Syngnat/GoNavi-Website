---
import type { Locale } from '../lib/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const isZh = locale === 'zh';

// Descriptions and taglines are the sponsors' own copy; keep them word for word.
const copy = isZh
  ? {
      title: '赞助商',
      thanks: '感谢以下赞助商支持 GoNavi 的开源开发。',
      invite: '想赞助 GoNavi？加微信',
      inviteNote: '（备注「GoNavi」）',
      contactHandle: 'ygf1140302783',
      contactHref: '',
      contactCopyHint: '点击复制微信号',
      contactCopied: '已复制',
      contactCopyFailed: '复制失败，请手动复制',
      visit: '访问官网',
      more: '展开',
      less: '收起',
      sponsors: [
        {
          id: 'apismart',
          name: 'APISmart',
          tagline: '统一 AI 模型 API · OpenAI 兼容',
          description: 'APISmart 通过一个 API 提供对主流 AI 模型的统一访问。开发者只需一个 API Key，即可通过兼容 OpenAI 的接口接入大语言模型、图像和视频模型，无需分别管理多个服务商。智能路由与自动故障切换有助于提升可靠性，集中式账单使使用管理更加轻松。借助 APISmart，开发者能以更精简的平台更快构建并扩展 AI 应用。',
          newWindow: '在新窗口打开 APISmart 官网',
          href: 'https://www.apismart.ai/',
          logo: '/sponsors/apismart.webp',
          logoWidth: 444,
          logoHeight: 96,
          logoStyle: 'wide',
        },
        {
          id: 'hualong',
          name: '華龍算力',
          tagline: 'AI API Gateway · 多模型统一接入 · 国内直连高速端点',
          description: '華龍算力是一家面向重度 AI 开发者、专注官方直连的高品质模型 API 中转服务商。主要营业 Codex 系列模型，100% 官方源直供，不掺假不注水，欢迎检验。计费透明，Token 级账单可逐笔核验。同时支持企业级高并发，并为企业客户提供专业的管理平台；企业客户可签订正式合同并开具发票，更多详情请进入官网获取联系方式。GPT 系列最低至 0.08 倍率，更有 0.15 倍率的 Pro 稳定分组；邀请好友双向赠送，邀请奖励无上限。',
          newWindow: '在新窗口打开華龍算力官网',
          href: 'https://gonavi.hualong.online/',
          logo: '/sponsors/hualong.webp',
          logoWidth: 188,
          logoHeight: 192,
          logoStyle: 'square',
        },
      ],
    }
  : {
      title: 'Sponsors',
      thanks: "Thanks to these sponsors for supporting GoNavi's open-source development.",
      invite: 'Want to sponsor GoNavi? Message the maintainer on Telegram:',
      inviteNote: '',
      contactHandle: '@Syngnat',
      contactHref: 'https://t.me/Syngnat',
      contactCopyHint: '',
      contactCopied: '',
      contactCopyFailed: '',
      visit: 'Visit website',
      more: 'Show more',
      less: 'Show less',
      sponsors: [
        {
          id: 'apismart',
          name: 'APISmart',
          tagline: 'Unified AI model API · OpenAI-compatible',
          description: 'APISmart provides unified access to leading AI models through a single API. Developers can connect to LLM, image, and video models using one API key and an OpenAI-compatible interface. This eliminates the need to manage multiple providers separately. Intelligent routing and automatic failover help improve reliability, while centralized billing makes usage easier to manage. With APISmart, developers can build and scale AI applications faster through one streamlined platform.',
          newWindow: 'Open the APISmart website in a new window',
          href: 'https://www.apismart.ai/',
          logo: '/sponsors/apismart.webp',
          logoWidth: 444,
          logoHeight: 96,
          logoStyle: 'wide',
        },
        {
          id: 'hualong',
          name: 'HuaLongAI',
          tagline: 'AI API Gateway · multi-model routing · domestic high-speed endpoint',
          description: 'HuaLongAI is a premium model API relay provider for power AI developers, focused on official direct connectivity. It primarily offers Codex-series models supplied directly from official sources, with no substitutions or dilution, and invites verification. Billing is transparent, with token-level itemized records available for review. It supports enterprise-grade high concurrency and provides enterprise customers with a professional management platform, formal contracts, and invoices; visit the website for contact details. GPT-series models start at a 0.08 rate, with a stable Pro group at 0.15, two-way referral gifts, and uncapped referral rewards.',
          newWindow: 'Open the HuaLongAI website in a new window',
          href: 'https://gonavi.hualong.online/',
          logo: '/sponsors/hualong.webp',
          logoWidth: 188,
          logoHeight: 192,
          logoStyle: 'square',
        },
      ],
    };
---
<aside
  class="sponsors"
  data-sponsors
  data-sponsor-config-url="/sponsor-config.json"
  data-more={copy.more}
  data-less={copy.less}
  aria-labelledby="sponsors-title"
  hidden
>
  <div class="site-shell__inner">
    <div class="sponsors__head">
      <div class="sponsors__heading">
        <h2 class="sponsors__title" id="sponsors-title">{copy.title}</h2>
        <p class="sponsors__thanks">{copy.thanks}</p>
      </div>
      <p class="sponsors__invite">
        {copy.invite}
        {' '}
        {copy.contactHref ? (
          <a class="sponsors__contact" href={copy.contactHref} target="_blank" rel="noopener noreferrer">{copy.contactHandle}</a>
        ) : (
          <span class="sponsors__copy-wrap">
            <button
              type="button"
              class="sponsors__contact sponsors__contact--copy"
              data-sponsor-contact-copy
              data-sponsor-contact-value={copy.contactHandle}
              data-sponsor-contact-success={copy.contactCopied}
              data-sponsor-contact-failure={copy.contactCopyFailed}
              aria-label={`${copy.contactHandle}，${copy.contactCopyHint}`}
              title={copy.contactCopyHint}
            >
              {copy.contactHandle}
              <svg width="13" height="13" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="5.5" y="5.5" width="8" height="8" rx="1.5" />
                <path d="M10.5 5.5v-2a1 1 0 0 0-1-1h-6a1 1 0 0 0-1 1v6a1 1 0 0 0 1 1h2" />
              </svg>
            </button>
            <span class="sponsors__copy-feedback" data-sponsor-contact-feedback aria-live="polite"></span>
          </span>
        )}
        {copy.inviteNote}
      </p>
    </div>

    <ul class="sponsors__list" data-sponsor-list>
      {copy.sponsors.map((sponsor) => (
        <li class="sponsor-card" data-sponsor-card data-sponsor-id={sponsor.id}>
          <a
            class="sponsor-card__logo"
            href={sponsor.href}
            target="_blank"
            rel="sponsored noopener noreferrer"
            tabindex="-1"
            aria-hidden="true"
            data-sponsor-action
            data-sponsor-id={sponsor.id}
          >
            <img
              class={`sponsor-card__logo-img sponsor-card__logo-img--${sponsor.logoStyle}`}
              src={sponsor.logo}
              alt=""
              width={sponsor.logoWidth}
              height={sponsor.logoHeight}
              loading="lazy"
              decoding="async"
            />
          </a>

          <div class="sponsor-card__body">
            <div class="sponsor-card__top">
              <h3 class="sponsor-card__name">{sponsor.name}</h3>
              <a
                class="sponsor-card__visit"
                href={sponsor.href}
                target="_blank"
                rel="sponsored noopener noreferrer"
                aria-label={sponsor.newWindow}
                data-sponsor-action
                data-sponsor-id={sponsor.id}
              >
                {copy.visit}
                <svg width="13" height="13" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M5 11 11 5M6 5h5v5" />
                </svg>
              </a>
            </div>
            <p class="sponsor-card__tagline">{sponsor.tagline}</p>
            <p class="sponsor-card__desc" id={`sponsor-desc-${sponsor.id}`} data-sponsor-desc>{sponsor.description}</p>
            <button
              type="button"
              class="sponsor-card__more"
              aria-expanded="false"
              aria-controls={`sponsor-desc-${sponsor.id}`}
              hidden
              data-sponsor-more
            >
              {copy.more}
            </button>
          </div>
        </li>
      ))}
    </ul>
  </div>
</aside>

<script>
  import { trackSponsorClick, trackSponsorImpression } from '../lib/analytics-client';
  import { copyText } from '../lib/clipboard';

  type SponsorControl = { enabled?: boolean; startsOn?: string; endsOn?: string; weight?: number };

  document.querySelectorAll<HTMLElement>('[data-sponsors]').forEach((root) => {
    const list = root.querySelector<HTMLElement>('[data-sponsor-list]');
    const allCards = Array.from(root.querySelectorAll<HTMLElement>('[data-sponsor-card]'));
    const configUrl = root.dataset.sponsorConfigUrl || '/sponsor-config.json';
    if (!list) return;

    // Campaign dates in the config are calendar days in China.
    const campaignDay = new Intl.DateTimeFormat('sv-SE', {
      timeZone: 'Asia/Shanghai',
      year: 'numeric',
      month: '2-digit',
      day: '2-digit',
    }).format(new Date());

    const isActive = (control?: SponsorControl) => Boolean(
      control
      && control.enabled === true
      && (!control.startsOn || control.startsOn <= campaignDay)
      && (!control.endsOn || campaignDay <= control.endsOn),
    );

    // Long descriptions show a few lines; "show more" appears only when there is more to show.
    const syncMoreButtons = () => {
      root.querySelectorAll<HTMLElement>('[data-sponsor-card]').forEach((card) => {
        const desc = card.querySelector<HTMLElement>('[data-sponsor-desc]');
        const more = card.querySelector<HTMLButtonElement>('[data-sponsor-more]');
        if (!desc || !more || card.hasAttribute('data-open')) return;
        more.hidden = desc.scrollHeight <= desc.clientHeight + 1;
      });
    };

    const initialise = async () => {
      // The query token also bypasses intermediary caches that may ignore a
      // browser's Cache-Control request header. The JSON itself remains the
      // single mutable, runtime source of truth for campaign availability.
      const separator = configUrl.includes('?') ? '&' : '?';
      const response = await fetch(`${configUrl}${separator}_=${Date.now()}`, { cache: 'no-store' });
      if (!response.ok) throw new Error(`Unable to load sponsor configuration: ${response.status}`);

      const config = await response.json();
      const controls: Record<string, SponsorControl> = config?.sponsors || {};
      const cards = allCards
        .filter((card) => isActive(controls[card.dataset.sponsorId ?? '']))
        .sort((l, r) => (controls[l.dataset.sponsorId ?? '']?.weight ?? 100) - (controls[r.dataset.sponsorId ?? '']?.weight ?? 100));
      if (cards.length === 0) return;

      // Inactive campaigns leave the page entirely; active ones go in weight order.
      allCards.forEach((card) => {
        if (!cards.includes(card)) card.remove();
      });
      cards.forEach((card) => list.append(card));
      root.dataset.count = String(cards.length);
      root.hidden = false;
      syncMoreButtons();
      window.addEventListener('resize', syncMoreButtons, { passive: true });

      cards.forEach((card) => {
        const more = card.querySelector<HTMLButtonElement>('[data-sponsor-more]');
        more?.addEventListener('click', () => {
          const open = !card.hasAttribute('data-open');
          card.toggleAttribute('data-open', open);
          more.setAttribute('aria-expanded', String(open));
          more.textContent = (open ? root.dataset.less : root.dataset.more) ?? '';
        });

        card.querySelectorAll<HTMLAnchorElement>('[data-sponsor-action]').forEach((link) => {
          link.addEventListener('click', () => trackSponsorClick(link.dataset.sponsorId || '', link.href));
        });
      });

      // One impression per sponsor, counted when at least half of its card has been on screen.
      const seen = new Set<string>();
      const record = (card: HTMLElement) => {
        const id = card.dataset.sponsorId;
        if (!id || seen.has(id)) return;
        seen.add(id);
        trackSponsorImpression(id);
      };

      if ('IntersectionObserver' in window) {
        const observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            record(entry.target as HTMLElement);
            observer.unobserve(entry.target);
          });
        }, { threshold: 0.5 });
        cards.forEach((card) => observer.observe(card));
      } else {
        cards.forEach(record);
      }
    };

    initialise().catch(() => {});
  });

  document.querySelectorAll<HTMLButtonElement>('[data-sponsor-contact-copy]').forEach((button) => {
    const feedback = button.parentElement?.querySelector<HTMLElement>('[data-sponsor-contact-feedback]');
    let resetTimer: number | undefined;

    button.addEventListener('click', async () => {
      window.clearTimeout(resetTimer);

      try {
        await copyText(button.dataset.sponsorContactValue ?? '');
        button.dataset.copyState = 'success';
        if (feedback) feedback.textContent = button.dataset.sponsorContactSuccess ?? '';
      } catch {
        button.dataset.copyState = 'failure';
        if (feedback) feedback.textContent = button.dataset.sponsorContactFailure ?? '';
      }

      resetTimer = window.setTimeout(() => {
        delete button.dataset.copyState;
        if (feedback) feedback.textContent = '';
      }, 1800);
    });
  });
</script>
