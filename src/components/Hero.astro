---
import type { Locale } from '../lib/i18n';
import { withLocale } from '../lib/i18n';

interface Props {
  locale: Locale;
  eyebrow: string;
  title: string;
  description: string;
  primary: { label: string; href: string };
  secondary: { label: string; href: string };
  highlights: string[];
}

const { locale, eyebrow, title, description, primary, secondary, highlights } = Astro.props;

const primaryHref = primary.href.startsWith('/') ? withLocale(locale, primary.href.replace(/^\/(zh|en)/, '')) : primary.href;
---
<section class="home-section-wrap home-section-wrap--hero">
  <div class="site-shell__inner">
    <div class="home-hero home-hero--stacked">
      <div class="home-hero__content">
        <div>
          <p class="section-eyebrow">{eyebrow}</p>
          <h1 class="home-hero__title">{title}</h1>
        </div>
        <p class="home-hero__desc">{description}</p>

        <div class="home-hero__cta-row">
          <a class="home-cta home-cta--primary" href={primaryHref}>{primary.label}</a>
          <a class="home-cta home-cta--secondary" href={secondary.href} rel="noreferrer" target="_blank">
            {secondary.label}
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M7 17L17 7M17 7H7M17 7V17" />
            </svg>
          </a>
        </div>

        <div class="home-hero__highlights">
          {highlights.map((h) => <span class="hero-tag">{h}</span>)}
        </div>
      </div>
    </div>
  </div>
</section>
