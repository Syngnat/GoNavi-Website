---
import { footerCopy, GITHUB_URL, GITHUB_ISSUES_URL, GITHUB_DISCUSSIONS_URL, withLocale } from '../lib/i18n';
import type { Locale } from '../lib/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = footerCopy[locale];
---
<footer class="site-footer">
  <div class="site-shell__inner">
    <div class="site-footer__inner">
      <div class="site-footer__brand-block">
        <div class="site-footer__brand">
          <span class="site-footer__logo">
            <img src="/logo.webp" alt="GoNavi" width="24" height="24" />
          </span>
          GoNavi
        </div>
        <p class="site-footer__copy">{copy.copy}</p>
      </div>

      <div class="site-footer__links">
        <div class="site-footer__group">
          <p class="site-footer__group-label">{copy.product}</p>
          <div class="site-footer__group-links">
            <a class="site-footer__group-link" href={withLocale(locale, '/download')}>
              {locale === 'zh' ? '下载' : 'Download'}
            </a>
            <a class="site-footer__group-link" href={withLocale(locale, '/docs')}>
              {locale === 'zh' ? '文档' : 'Docs'}
            </a>
            <a class="site-footer__group-link" href={withLocale(locale, '/blog')}>
              {locale === 'zh' ? '博客' : 'Blog'}
            </a>
            <a class="site-footer__group-link" href={withLocale(locale, '/changelog')}>
              {locale === 'zh' ? '更新日志' : 'Changelog'}
            </a>
            <a class="site-footer__group-link" href={withLocale(locale, '/roadmap')}>
              {locale === 'zh' ? '路线图' : 'Roadmap'}
            </a>
          </div>
        </div>

        <div class="site-footer__group">
          <p class="site-footer__group-label">{copy.resources}</p>
          <div class="site-footer__group-links">
            <a class="site-footer__group-link" href={withLocale(locale, '/docs/install')}>
              {locale === 'zh' ? '安装指南' : 'Installation'}
            </a>
            <a class="site-footer__group-link" href={GITHUB_URL} target="_blank" rel="noreferrer">
              {copy.github}
            </a>
            <a class="site-footer__group-link" href={GITHUB_ISSUES_URL} target="_blank" rel="noreferrer">
              {copy.issues}
            </a>
          </div>
        </div>

        <div class="site-footer__group">
          <p class="site-footer__group-label">{copy.community}</p>
          <div class="site-footer__group-links">
            <a class="site-footer__group-link" href={GITHUB_DISCUSSIONS_URL} target="_blank" rel="noreferrer">
              {copy.discussions}
            </a>
            <button
              type="button"
              class={`site-footer__telegram site-footer__telegram--wechat${locale === 'zh' ? ' site-footer__telegram--wechat--zh' : ''}`}
              data-wechat-copy
              data-wechat-id={copy.wechatId}
              data-wechat-default={`${copy.wechat} · ${copy.wechatId}`}
              data-wechat-success={copy.wechatCopied}
              data-wechat-failure={copy.wechatCopyFailed}
              aria-label={`${copy.wechat} · ${copy.wechatId}。${copy.wechatCopyHint}`}
              title={copy.wechatCopyHint}
            >
              <span class="site-footer__contact-label">
                <span data-wechat-copy-label aria-live="polite">{copy.wechat} · {copy.wechatId}</span>
                <span class="site-footer__contact-label-measure" aria-hidden="true">{copy.wechat} · {copy.wechatId}</span>
                <span class="site-footer__contact-label-measure" aria-hidden="true">{copy.wechatCopyFailed}</span>
              </span>
            </button>
            {locale === 'en' && (
              <a
                class="site-footer__telegram"
                href="https://t.me/Syngnat"
                target="_blank"
                rel="noopener noreferrer"
                aria-label="Open @Syngnat on Telegram"
              >
                Telegram · @Syngnat
              </a>
            )}
          </div>
        </div>
      </div>
    </div>

    <div class="site-footer__bottom">
      <span>© {new Date().getFullYear()} GoNavi</span>
      <span>{copy.license}</span>
    </div>
  </div>
</footer>

<script>
  import { copyText } from '../lib/clipboard';

  document.querySelectorAll<HTMLButtonElement>('[data-wechat-copy]').forEach((button) => {
    const label = button.querySelector<HTMLElement>('[data-wechat-copy-label]');
    const defaultText = button.dataset.wechatDefault ?? '';
    let resetTimer: number | undefined;

    button.addEventListener('click', async () => {
      window.clearTimeout(resetTimer);

      try {
        await copyText(button.dataset.wechatId ?? '');
        button.dataset.copyState = 'success';
        if (label) label.textContent = button.dataset.wechatSuccess ?? defaultText;
      } catch {
        button.dataset.copyState = 'failure';
        if (label) label.textContent = button.dataset.wechatFailure ?? defaultText;
      }

      resetTimer = window.setTimeout(() => {
        delete button.dataset.copyState;
        if (label) label.textContent = defaultText;
      }, 1800);
    });
  });
</script>
