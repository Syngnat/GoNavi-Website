---
import type { Locale } from '../lib/i18n';

interface Props {
  locale: Locale;
  data: {
    kicker: string;
    title: string;
    description: string;
    points: string[];
    clientsLabel: string;
    clients: string[];
    flow: { label: string; steps: string[] };
    snippets: { id: string; label: string; code: string }[];
    link: { label: string; href: string };
  };
}

const { locale, data } = Astro.props;
const isZh = locale === 'zh';
const copy = {
  copy: isZh ? '复制' : 'Copy',
  copied: isZh ? '已复制' : 'Copied',
  failed: isZh ? '复制失败' : 'Copy failed',
  snippets: isZh ? '部署与调用方式' : 'Ways to run it',
};
---
<section class="section" id="agents">
  <div class="site-shell__inner agents">
    <div class="agents__copy">
      <header class="section-head agents__head">
        <p class="section-kicker">{data.kicker}</p>
        <h2 class="section-title">{data.title}</h2>
        <p class="section-desc">{data.description}</p>
      </header>

      <ul class="agents__points">
        {data.points.map((point) => <li>{point}</li>)}
      </ul>

      <div class="agents__clients">
        <p class="agents__clients-label">{data.clientsLabel}</p>
        <ul class="agents__client-list">
          {data.clients.map((client) => <li>{client}</li>)}
        </ul>
      </div>

      <a class="text-link" href={data.link.href} target="_blank" rel="noreferrer">
        {data.link.label}
        <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M5 11 11 5M6 5h5v5" />
        </svg>
      </a>
    </div>

    <div class="terminal" data-terminal>
      <div class="terminal__bar">
        <div class="terminal__tabs" role="tablist" aria-label={copy.snippets}>
          {data.snippets.map((snippet, index) => (
            <button
              type="button"
              role="tab"
              class="terminal__tab"
              id={`terminal-tab-${snippet.id}`}
              aria-selected={index === 0 ? 'true' : 'false'}
              aria-controls={`terminal-panel-${snippet.id}`}
              tabindex={index === 0 ? 0 : -1}
              data-terminal-tab
            >
              {snippet.label}
            </button>
          ))}
        </div>
        <button
          type="button"
          class="terminal__copy"
          data-terminal-copy
          data-label={copy.copy}
          data-label-success={copy.copied}
          data-label-failure={copy.failed}
        >
          <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="5.5" y="5.5" width="8" height="8" rx="1.5" />
            <path d="M10.5 5.5v-2a1 1 0 0 0-1-1h-6a1 1 0 0 0-1 1v6a1 1 0 0 0 1 1h2" />
          </svg>
          <span data-terminal-copy-label aria-live="polite">{copy.copy}</span>
        </button>
      </div>

      {data.snippets.map((snippet, index) => (
        <div
          class="terminal__panel"
          role="tabpanel"
          id={`terminal-panel-${snippet.id}`}
          aria-labelledby={`terminal-tab-${snippet.id}`}
          tabindex="0"
          hidden={index !== 0}
          data-terminal-panel
        >
          <pre class="terminal__code"><code>{snippet.code}</code></pre>
        </div>
      ))}

      <div class="terminal__flow">
        <p class="terminal__flow-label">{data.flow.label}</p>
        <ol class="terminal__flow-steps">
          {data.flow.steps.map((step) => <li>{step}</li>)}
        </ol>
      </div>
    </div>
  </div>
</section>

<script>
  import { copyText } from '../lib/clipboard';

  function initTerminal(root: HTMLElement) {
    if (root.dataset.ready === '1') return;
    root.dataset.ready = '1';

    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-terminal-tab]'));
    const panels = Array.from(root.querySelectorAll<HTMLElement>('[data-terminal-panel]'));
    let active = 0;

    const show = (index: number, focus = false) => {
      active = (index + tabs.length) % tabs.length;
      tabs.forEach((tab, i) => {
        tab.setAttribute('aria-selected', String(i === active));
        tab.tabIndex = i === active ? 0 : -1;
      });
      panels.forEach((panel, i) => { panel.hidden = i !== active; });
      if (focus) tabs[active].focus();
    };

    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => show(index));
      tab.addEventListener('keydown', (event) => {
        if (event.key === 'ArrowRight') { event.preventDefault(); show(active + 1, true); }
        if (event.key === 'ArrowLeft') { event.preventDefault(); show(active - 1, true); }
        if (event.key === 'Home') { event.preventDefault(); show(0, true); }
        if (event.key === 'End') { event.preventDefault(); show(tabs.length - 1, true); }
      });
    });

    const copyButton = root.querySelector<HTMLButtonElement>('[data-terminal-copy]');
    const copyLabel = root.querySelector<HTMLElement>('[data-terminal-copy-label]');
    let resetTimer: number | undefined;

    copyButton?.addEventListener('click', async () => {
      window.clearTimeout(resetTimer);
      // Shell line continuations are for reading; hand over one runnable command per line.
      const code = (panels[active]?.textContent ?? '').trim().replace(/\s*\\\n\s*/g, ' ');

      try {
        await copyText(code);
        copyButton.dataset.copyState = 'success';
        if (copyLabel) copyLabel.textContent = copyButton.dataset.labelSuccess ?? '';
      } catch {
        copyButton.dataset.copyState = 'failure';
        if (copyLabel) copyLabel.textContent = copyButton.dataset.labelFailure ?? '';
      }

      resetTimer = window.setTimeout(() => {
        delete copyButton.dataset.copyState;
        if (copyLabel) copyLabel.textContent = copyButton.dataset.label ?? '';
      }, 1800);
    });
  }

  const initTerminals = () => document.querySelectorAll<HTMLElement>('[data-terminal]').forEach(initTerminal);
  initTerminals();
  document.addEventListener('astro:page-load', initTerminals);
</script>
