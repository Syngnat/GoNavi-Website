---
import type { Locale } from '../lib/i18n';
import { GITHUB_URL, navCopy, otherLocale, stripLocale, withLocale } from '../lib/i18n';
import { fetchGitHubStats } from '../lib/releases';

interface Props {
  locale: Locale;
  /** path fragment without locale, e.g. '/' | '/download' | '/docs/install' */
  current: string;
}

const { locale, current } = Astro.props;
const nav = navCopy[locale];
const stats = await fetchGitHubStats();

const formatCount = (n: number): string => {
  if (n >= 1000) return `${(n / 1000).toFixed(1)}k`;
  return String(n);
};

const links: Array<{ key: string; path: string; label: string }> = [
  { key: 'home', path: '/', label: nav.home },
  { key: 'download', path: '/download', label: nav.download },
  { key: 'docs', path: '/docs', label: nav.docs },
  { key: 'changelog', path: '/changelog', label: nav.changelog },
  { key: 'roadmap', path: '/roadmap', label: nav.roadmap },
];

function isActive(linkPath: string): boolean {
  if (linkPath === '/') return current === '/' || current === '';
  return current === linkPath || current.startsWith(`${linkPath}/`);
}

const nextLocale = otherLocale(locale);
---
<header class="site-header">
  <div class="site-shell__inner site-header__inner">
    <a class="site-brand" href={withLocale(locale, '/')}>
      <span class="site-brand__logo">
        <img src="/logo.webp" alt="GoNavi" width="28" height="28" />
      </span>
      <span class="site-brand__name">GoNavi</span>
      <span class="site-brand__tag">{nav.brandTag}</span>
    </a>

    <div class="site-header__meta">
      <nav class="site-nav" aria-label="primary">
        {links.map((link) => (
          <a
            href={withLocale(locale, link.path)}
            class:list={['site-nav__link', { 'site-nav__link--active': isActive(link.path) }]}
            aria-current={isActive(link.path) ? 'page' : undefined}
          >
            {link.label}
          </a>
        ))}
      </nav>

      <div class="locale-switch" aria-label="locale">
        <a
          class="locale-switch__link"
          href={withLocale('zh', stripLocale(Astro.url.pathname))}
          aria-current={locale === 'zh' ? 'page' : undefined}
        >
          ZH
        </a>
        <span class="locale-switch__divider" aria-hidden="true" />
        <a
          class="locale-switch__link"
          href={withLocale('en', stripLocale(Astro.url.pathname))}
          aria-current={locale === 'en' ? 'page' : undefined}
        >
          EN
        </a>
      </div>

      <a
        class="site-header__external"
        href={GITHUB_URL}
        rel="noreferrer"
        target="_blank"
        aria-label="GitHub"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.55v-2.15c-3.2.7-3.87-1.37-3.87-1.37-.53-1.33-1.28-1.69-1.28-1.69-1.05-.72.08-.71.08-.71 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.72-1.55-2.55-.29-5.23-1.28-5.23-5.68 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11.1 11.1 0 0 1 5.8 0c2.21-1.49 3.18-1.18 3.18-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.84 1.19 3.1 0 4.41-2.69 5.38-5.25 5.66.41.36.77 1.06.77 2.14v3.17c0 .3.21.66.8.55A11.5 11.5 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5Z"/>
        </svg>
        <span class="site-header__gh-stars"><span class="gh-star">★</span> {formatCount(stats.stars)}</span>
        <span class="site-header__gh-downloads"><span class="gh-download">⬇</span> {formatCount(stats.totalDownloads)}</span>
      </a>
    </div>
  </div>
</header>
