---
import type { Locale } from '../lib/i18n';
import { GITHUB_URL, navCopy, stripLocale, withLocale } from '../lib/i18n';
import { fetchGitHubStats, formatCount } from '../lib/releases';

interface Props {
  locale: Locale;
  /** path fragment without locale, e.g. '/' | '/download' | '/docs/install' */
  current: string;
}

const { locale, current } = Astro.props;
const nav = navCopy[locale];
const stats = await fetchGitHubStats();
const isZh = locale === 'zh';

const links: Array<{ path: string; label: string }> = [
  { path: '/download', label: nav.download },
  { path: '/docs', label: nav.docs },
  { path: '/blog', label: nav.blog },
  { path: '/changelog', label: nav.changelog },
  { path: '/roadmap', label: nav.roadmap },
];

function isActive(linkPath: string): boolean {
  return current === linkPath || current.startsWith(`${linkPath}/`);
}

const routePath = stripLocale(Astro.url.pathname);
const copy = {
  primaryNav: isZh ? '主导航' : 'Primary',
  language: isZh ? '语言' : 'Language',
  menu: isZh ? '菜单' : 'Menu',
  githubLabel: isZh ? `GitHub 仓库，${formatCount(stats.stars)} 个 Star` : `GitHub repository, ${formatCount(stats.stars)} stars`,
};
---
<header class="site-header" data-site-header>
  <div class="site-shell__inner site-header__inner">
    <a class="site-brand" href={withLocale(locale, '/')} aria-label={isZh ? 'GoNavi 首页' : 'GoNavi home'}>
      <img class="site-brand__logo" src="/logo-mark.webp" alt="" width="28" height="28" />
      <span class="site-brand__name">GoNavi</span>
    </a>

    <nav class="site-nav" aria-label={copy.primaryNav}>
      {links.map((link) => (
        <a
          href={withLocale(locale, link.path)}
          class="site-nav__link"
          aria-current={isActive(link.path) ? 'page' : undefined}
        >
          {link.label}
        </a>
      ))}
    </nav>

    <div class="site-header__tools">
      <div class="locale-switch" role="group" aria-label={copy.language}>
        <a
          class="locale-switch__link"
          href={withLocale('zh', routePath)}
          hreflang="zh-CN"
          lang="zh-CN"
          aria-current={isZh ? 'true' : undefined}
        >
          中文
        </a>
        <a
          class="locale-switch__link"
          href={withLocale('en', routePath)}
          hreflang="en-US"
          lang="en"
          aria-current={!isZh ? 'true' : undefined}
        >
          EN
        </a>
      </div>

      <a class="site-header__github" href={GITHUB_URL} rel="noreferrer" target="_blank" aria-label={copy.githubLabel}>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.55v-2.15c-3.2.7-3.87-1.37-3.87-1.37-.53-1.33-1.28-1.69-1.28-1.69-1.05-.72.08-.71.08-.71 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.72-1.55-2.55-.29-5.23-1.28-5.23-5.68 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11.1 11.1 0 0 1 5.8 0c2.21-1.49 3.18-1.18 3.18-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.84 1.19 3.1 0 4.41-2.69 5.38-5.25 5.66.41.36.77 1.06.77 2.14v3.17c0 .3.21.66.8.55A11.5 11.5 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5Z"/>
        </svg>
        {stats.stars > 0 && <span>{formatCount(stats.stars)}</span>}
      </a>

      <a class="btn btn--primary btn--sm site-header__download" href={withLocale(locale, '/download')}>
        {nav.download}
      </a>

      <button
        type="button"
        class="site-header__menu-btn"
        aria-expanded="false"
        aria-controls="site-menu"
        aria-label={copy.menu}
        data-menu-btn
      >
        <svg class="site-header__menu-icon" width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true">
          <line x1="3" y1="5" x2="17" y2="5" />
          <line x1="3" y1="10" x2="17" y2="10" />
          <line x1="3" y1="15" x2="17" y2="15" />
        </svg>
      </button>
    </div>
  </div>

  <div class="site-menu" id="site-menu" hidden data-menu>
    <nav class="site-shell__inner" aria-label={copy.primaryNav}>
      <ul class="site-menu__list">
        {links.map((link) => (
          <li>
            <a
              class="site-menu__link"
              href={withLocale(locale, link.path)}
              aria-current={isActive(link.path) ? 'page' : undefined}
            >
              {link.label}
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M6 3.5 10.5 8 6 12.5" />
              </svg>
            </a>
          </li>
        ))}
      </ul>
      <div class="site-menu__actions">
        <a class="btn btn--primary" href={withLocale(locale, '/download')}>{nav.download}</a>
        <a class="btn btn--secondary" href={GITHUB_URL} rel="noreferrer" target="_blank">GitHub</a>
      </div>
    </nav>
  </div>
</header>

<script>
  function initSiteHeader() {
    const header = document.querySelector<HTMLElement>('[data-site-header]');
    if (!header || header.dataset.ready === '1') return;
    header.dataset.ready = '1';

    const syncScrolled = () => {
      header.toggleAttribute('data-scrolled', window.scrollY > 4);
    };
    syncScrolled();
    window.addEventListener('scroll', syncScrolled, { passive: true });

    const btn = header.querySelector<HTMLButtonElement>('[data-menu-btn]');
    const menu = header.querySelector<HTMLElement>('[data-menu]');
    if (!btn || !menu) return;

    const setOpen = (open: boolean) => {
      btn.setAttribute('aria-expanded', String(open));
      menu.hidden = !open;
      header.toggleAttribute('data-menu-open', open);
    };

    btn.addEventListener('click', () => setOpen(btn.getAttribute('aria-expanded') !== 'true'));

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && btn.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        btn.focus();
      }
    });

    document.addEventListener('click', (event) => {
      if (!header.contains(event.target as Node)) setOpen(false);
    });

    // The menu only exists below the desktop breakpoint; never leave it open across a resize.
    window.matchMedia('(min-width: 901px)').addEventListener('change', (event) => {
      if (event.matches) setOpen(false);
    });
  }

  initSiteHeader();
  document.addEventListener('astro:page-load', initSiteHeader);
</script>
