---
import type { Locale } from '../lib/i18n';
import { GITHUB_ISSUES_URL, withLocale } from '../lib/i18n';

interface Source {
  name: string;
  category: string;
  status: 'primary' | 'supported';
  detail: string;
  doc?: string;
}

interface Props {
  locale: Locale;
  heading: {
    kicker: string;
    title: string;
    description: string;
    categories: { id: string; label: string }[];
  };
  rows: Source[];
}

const { locale, heading, rows } = Astro.props;
const isZh = locale === 'zh';

const groups = heading.categories
  .map((category) => ({ ...category, rows: rows.filter((row) => row.category === category.id) }))
  .filter((group) => group.rows.length > 0);

const builtInCount = rows.filter((row) => row.status === 'primary').length;
const optionalCount = rows.length - builtInCount;

/** What people actually type when they look for these. Keyed by a fragment of the display name. */
const aliases: Record<string, string[]> = {
  PostgreSQL: ['pg', 'postgres'],
  'SQL Server': ['mssql', 'sqlserver'],
  Elasticsearch: ['es'],
  MongoDB: ['mongo'],
  ZooKeeper: ['zk'],
  ClickHouse: ['ck'],
  OceanBase: ['ob'],
  Dameng: ['达梦', 'dm', 'dm8'],
  Kingbase: ['人大金仓', '金仓', 'kingbasees'],
  HighGo: ['瀚高'],
  Vastbase: ['海量'],
  YashanDB: ['崖山'],
  IRIS: ['iris'],
  'Caché': ['cache'],
};

const splitDetail = (detail: string) => detail.split(isZh ? '、' : ', ').map((part) => part.trim()).filter(Boolean);
const keywordsFor = (row: Source, categoryLabel: string) => {
  const extra = Object.entries(aliases).flatMap(([key, values]) => (row.name.includes(key) ? values : []));
  return [row.name, categoryLabel, ...extra].join(' ').normalize('NFKC').toLowerCase();
};

const copy = {
  search: isZh ? '搜索数据源' : 'Search data sources',
  placeholder: isZh ? '搜索你的数据库，例如 达梦、ClickHouse、pg' : 'Search for your database, e.g. ClickHouse, Dameng, pg',
  builtIn: isZh ? '内置' : 'Built-in',
  optional: isZh ? '可选驱动代理' : 'Optional driver agent',
  builtInMode: isZh ? '内置 · 开箱即用' : 'Built-in · ready out of the box',
  optionalMode: isZh ? '可选驱动代理 · 在驱动管理中安装启用' : 'Optional driver agent · install from the Driver Manager',
  capabilities: isZh ? '典型能力' : 'Typical capabilities',
  guide: isZh ? '查看使用指南' : 'Read the guide',
  allSources: isZh ? '数据源支持说明' : 'How data-source support works',
  emptyTitle: isZh ? '列表里没有' : 'Not in the list:',
  emptyBody: isZh
    ? '可以通过 Custom Driver + DSN 自行接入，或者在 GitHub 告诉我们你需要它。'
    : 'You can connect it yourself with Custom Driver + DSN, or tell us you need it on GitHub.',
  emptyDocs: isZh ? '了解 Custom Driver + DSN' : 'About Custom Driver + DSN',
  emptyIssue: isZh ? '提交需求' : 'Request it',
  wall: isZh ? '支持的数据源' : 'Supported data sources',
};

const first = groups[0]?.rows[0];
const firstGroup = groups[0];
---
<section class="section section--sunken" id="sources">
  <div class="site-shell__inner">
    <header class="section-head">
      <p class="section-kicker">{heading.kicker}</p>
      <h2 class="section-title">{heading.title}</h2>
      <p class="section-desc">{heading.description}</p>
    </header>

    <div
      class="sources"
      data-sources
      data-separator={isZh ? '、' : ', '}
      data-mode-primary={copy.builtInMode}
      data-mode-supported={copy.optionalMode}
      data-docs-base={withLocale(locale, '/docs')}
    >
      <div class="sources__main">
        <div class="sources__toolbar">
          <label class="sources__search">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
              <circle cx="11" cy="11" r="7" />
              <path d="m16.5 16.5 4 4" />
            </svg>
            <span class="sr-only">{copy.search}</span>
            <input
              type="search"
              placeholder={copy.placeholder}
              autocomplete="off"
              spellcheck="false"
              data-sources-search
            />
          </label>
          <ul class="sources__legend">
            <li><span class="source-dot source-dot--primary" aria-hidden="true"></span>{copy.builtIn}<span class="sources__legend-count">{builtInCount}</span></li>
            <li><span class="source-dot" aria-hidden="true"></span>{copy.optional}<span class="sources__legend-count">{optionalCount}</span></li>
          </ul>
        </div>

        <div class="sources__groups" role="group" aria-label={copy.wall} data-sources-groups>
          {groups.map((group) => (
            <div class="sources__group" data-sources-group>
              <h3 class="sources__group-label">
                {group.label}
                <span class="sources__group-count">{group.rows.length}</span>
              </h3>
              <ul class="sources__chips">
                {group.rows.map((row) => (
                  <li>
                    <button
                      type="button"
                      class="source-chip"
                      aria-pressed={row === first ? 'true' : 'false'}
                      tabindex={row === first ? 0 : -1}
                      data-source
                      data-name={row.name}
                      data-category={group.label}
                      data-status={row.status}
                      data-detail={row.detail}
                      data-doc={row.doc}
                      data-keywords={keywordsFor(row, group.label)}
                    >
                      <span class:list={['source-dot', { 'source-dot--primary': row.status === 'primary' }]} aria-hidden="true"></span>
                      {row.name}
                      <span class="sr-only">{row.status === 'primary' ? copy.builtIn : copy.optional}</span>
                    </button>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>

        <div class="sources__empty" data-sources-empty hidden>
          <p class="sources__empty-title">{copy.emptyTitle}<q data-sources-query></q></p>
          <p>{copy.emptyBody}</p>
          <p class="sources__empty-links">
            <a class="text-link" href={withLocale(locale, '/docs/connections')}>{copy.emptyDocs}</a>
            <a class="text-link" href={GITHUB_ISSUES_URL} target="_blank" rel="noreferrer">{copy.emptyIssue}</a>
          </p>
        </div>
      </div>

      {first && firstGroup && (
        <aside class="source-detail" aria-live="polite" data-source-detail>
          <p class="source-detail__category" data-detail-category>{firstGroup.label}</p>
          <h3 class="source-detail__name" data-detail-name>{first.name}</h3>
          <p class="source-detail__mode" data-detail-mode data-status={first.status}>
            <span class="source-dot" aria-hidden="true"></span>
            <span data-detail-mode-text>{first.status === 'primary' ? copy.builtInMode : copy.optionalMode}</span>
          </p>
          <p class="source-detail__label">{copy.capabilities}</p>
          <ul class="source-detail__caps" data-detail-caps>
            {splitDetail(first.detail).map((part) => <li>{part}</li>)}
          </ul>
          <div class="source-detail__links">
            <a
              class="text-link"
              href={first.doc ? withLocale(locale, `/docs/${first.doc}`) : undefined}
              hidden={!first.doc}
              data-detail-doc
            >
              {copy.guide}
            </a>
            <a class="text-link" href={withLocale(locale, '/docs/data-sources')}>{copy.allSources}</a>
          </div>
        </aside>
      )}
    </div>
  </div>
</section>

<script>
  function initSources(root: HTMLElement) {
    if (root.dataset.ready === '1') return;
    root.dataset.ready = '1';

    const chips = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-source]'));
    const groups = Array.from(root.querySelectorAll<HTMLElement>('[data-sources-group]'));
    const groupsWrap = root.querySelector<HTMLElement>('[data-sources-groups]');
    const search = root.querySelector<HTMLInputElement>('[data-sources-search]');
    const empty = root.querySelector<HTMLElement>('[data-sources-empty]');
    const emptyQuery = root.querySelector<HTMLElement>('[data-sources-query]');
    const detail = root.querySelector<HTMLElement>('[data-source-detail]');
    if (!groupsWrap || !detail || chips.length === 0) return;

    const field = (name: string) => detail.querySelector<HTMLElement>(`[data-detail-${name}]`);
    const separator = root.dataset.separator ?? ', ';
    const stacked = window.matchMedia('(max-width: 900px)');
    let pinned = chips.find((chip) => chip.getAttribute('aria-pressed') === 'true') ?? chips[0];

    const visibleChips = () => chips.filter((chip) => !chip.closest('li')?.hidden);

    const render = (chip: HTMLButtonElement) => {
      const status = chip.dataset.status === 'primary' ? 'primary' : 'supported';
      field('category')!.textContent = chip.dataset.category ?? '';
      field('name')!.textContent = chip.dataset.name ?? '';
      field('mode')!.dataset.status = status;
      field('mode-text')!.textContent = (status === 'primary' ? root.dataset.modePrimary : root.dataset.modeSupported) ?? '';
      field('caps')!.replaceChildren(
        ...(chip.dataset.detail ?? '').split(separator).filter(Boolean).map((part) => {
          const item = document.createElement('li');
          item.textContent = part.trim();
          return item;
        }),
      );
      const doc = field('doc') as HTMLAnchorElement;
      doc.hidden = !chip.dataset.doc;
      if (chip.dataset.doc) doc.href = `${root.dataset.docsBase}${chip.dataset.doc}/`;
      else doc.removeAttribute('href');
    };

    // Side by side on wide screens; on narrow ones the card sits right under the group that was tapped.
    const place = () => {
      if (stacked.matches) pinned.closest('[data-sources-group]')?.after(detail);
      else root.append(detail);
    };

    const pin = (chip: HTMLButtonElement) => {
      pinned = chip;
      chips.forEach((other) => {
        other.setAttribute('aria-pressed', String(other === chip));
        other.tabIndex = other === chip ? 0 : -1;
      });
      render(chip);
      place();
    };

    chips.forEach((chip) => {
      chip.addEventListener('click', () => pin(chip));
      // Hovering previews; the card falls back to the pinned source when the pointer leaves.
      chip.addEventListener('mouseenter', () => {
        if (!stacked.matches) render(chip);
      });
    });
    groupsWrap.addEventListener('mouseleave', () => render(pinned));

    groupsWrap.addEventListener('keydown', (event) => {
      const list = visibleChips();
      const index = list.indexOf(document.activeElement as HTMLButtonElement);
      if (index < 0) return;
      const moves: Record<string, number> = {
        ArrowRight: index + 1,
        ArrowDown: index + 1,
        ArrowLeft: index - 1,
        ArrowUp: index - 1,
        Home: 0,
        End: list.length - 1,
      };
      if (!(event.key in moves)) return;
      event.preventDefault();
      const next = list[(moves[event.key] + list.length) % list.length];
      pin(next);
      next.focus();
    });

    stacked.addEventListener('change', place);
    place();

    search?.addEventListener('input', () => {
      const query = search.value.normalize('NFKC').trim().toLowerCase();

      chips.forEach((chip) => {
        const item = chip.closest('li');
        if (item) item.hidden = query !== '' && !(chip.dataset.keywords ?? '').includes(query);
      });
      groups.forEach((group) => {
        group.hidden = group.querySelectorAll('li:not([hidden])').length === 0;
      });

      const matches = visibleChips();
      if (empty) empty.hidden = matches.length > 0;
      if (emptyQuery) emptyQuery.textContent = search.value.trim();
      detail.hidden = matches.length === 0;

      // Whatever is on the card should be something the visitor can still see in the list.
      if (matches.length > 0 && !matches.includes(pinned)) pin(matches[0]);
    });
  }

  const initAllSources = () => document.querySelectorAll<HTMLElement>('[data-sources]').forEach(initSources);
  initAllSources();
  document.addEventListener('astro:page-load', initAllSources);
</script>
