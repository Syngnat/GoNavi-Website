---
import type { Locale } from '../lib/i18n';

interface Props {
  locale: Locale;
  variant?: 'standalone' | 'sidebar';
}

const { locale, variant = 'standalone' } = Astro.props;
const isZh = locale === 'zh';
const inputId = `docs-search-${variant}-${locale}`;
const resultsId = `${inputId}-results`;
const copy = {
  label: isZh ? '搜索文档' : 'Search docs',
  placeholder: isZh ? '搜索标题、配置项或正文…' : 'Search titles, settings, or full text…',
  loading: isZh ? '正在加载文档索引…' : 'Loading documentation index…',
  empty: isZh ? '没有找到相关文档' : 'No matching documentation found',
  count: isZh ? '条结果' : 'results',
  error: isZh ? '搜索索引加载失败，请稍后重试' : 'Search index failed to load. Please try again.',
};
---
<div
  class:list={['docs-search', `docs-search--${variant}`]}
  data-docs-search
  data-locale={locale}
  data-loading={copy.loading}
  data-empty={copy.empty}
  data-count={copy.count}
  data-error={copy.error}
>
  <label class="docs-search__label" for={inputId}>{copy.label}</label>
  <div class="docs-search__field">
    <svg class="docs-search__icon" width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="2" />
      <path d="m16.5 16.5 4 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
    </svg>
    <input
      id={inputId}
      class="docs-search__input"
      type="search"
      placeholder={copy.placeholder}
      autocomplete="off"
      spellcheck="false"
      role="combobox"
      aria-autocomplete="list"
      aria-expanded="false"
      aria-controls={resultsId}
    />
    <kbd class="docs-search__shortcut" aria-hidden="true">/</kbd>
  </div>
  <div class="docs-search__results" hidden>
    <p class="docs-search__status" role="status" aria-live="polite"></p>
    <ul class="docs-search__list" id={resultsId} role="listbox"></ul>
  </div>
</div>

<script>
  interface SearchDocument {
    id: string;
    locale: 'zh' | 'en';
    title: string;
    summary: string;
    href: string;
    text: string;
  }

  let searchIndexPromise: Promise<SearchDocument[]> | null = null;

  const loadSearchIndex = (): Promise<SearchDocument[]> => {
    if (!searchIndexPromise) {
      searchIndexPromise = fetch('/docs-search.json', { credentials: 'same-origin' })
        .then(async (response) => {
          if (!response.ok) throw new Error(`Search index request failed: HTTP ${response.status}`);
          return response.json() as Promise<SearchDocument[]>;
        })
        .catch((error) => {
          searchIndexPromise = null;
          throw error;
        });
    }
    return searchIndexPromise;
  };

  const normalizeText = (value: string): string => value.normalize('NFKC').toLowerCase();
  const escapeRegExp = (value: string): string => value.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');

  function scoreDocument(doc: SearchDocument, query: string, terms: string[]): number {
    const title = normalizeText(doc.title);
    const summary = normalizeText(doc.summary);
    const text = normalizeText(doc.text);
    const searchable = `${title} ${summary} ${text}`;
    if (!terms.every((term) => searchable.includes(term))) return -1;

    let score = 0;
    if (title === query) score += 240;
    else if (title.includes(query)) score += 160;
    if (summary.includes(query)) score += 70;
    if (text.includes(query)) score += 25;
    for (const term of terms) {
      if (title.includes(term)) score += 35;
      if (summary.includes(term)) score += 15;
    }
    return score;
  }

  function makeSnippet(doc: SearchDocument, query: string, terms: string[]): string {
    const source = doc.text || doc.summary;
    if (!source) return doc.summary;
    const normalized = normalizeText(source);
    let matchAt = normalized.indexOf(query);
    if (matchAt < 0) {
      matchAt = terms.reduce((found, term) => {
        const index = normalized.indexOf(term);
        return index >= 0 && (found < 0 || index < found) ? index : found;
      }, -1);
    }
    if (matchAt < 0) return doc.summary || source.slice(0, 150);
    const start = Math.max(0, matchAt - 58);
    const end = Math.min(source.length, matchAt + Math.max(query.length, 18) + 92);
    return `${start > 0 ? '…' : ''}${source.slice(start, end).trim()}${end < source.length ? '…' : ''}`;
  }

  function appendHighlighted(target: HTMLElement, value: string, terms: string[]): void {
    const visibleTerms = [...new Set(terms)].filter(Boolean).sort((a, b) => b.length - a.length);
    if (visibleTerms.length === 0) {
      target.textContent = value;
      return;
    }
    const matcher = new RegExp(`(${visibleTerms.map(escapeRegExp).join('|')})`, 'giu');
    let cursor = 0;
    for (const match of value.matchAll(matcher)) {
      const index = match.index ?? 0;
      if (index > cursor) target.append(document.createTextNode(value.slice(cursor, index)));
      const mark = document.createElement('mark');
      mark.textContent = match[0];
      target.append(mark);
      cursor = index + match[0].length;
    }
    if (cursor < value.length) target.append(document.createTextNode(value.slice(cursor)));
  }

  document.querySelectorAll<HTMLElement>('[data-docs-search]').forEach((root) => {
    const input = root.querySelector<HTMLInputElement>('.docs-search__input');
    const panel = root.querySelector<HTMLElement>('.docs-search__results');
    const status = root.querySelector<HTMLElement>('.docs-search__status');
    const list = root.querySelector<HTMLUListElement>('.docs-search__list');
    const locale = root.dataset.locale;
    if (!input || !panel || !status || !list || !locale) return;

    let activeIndex = -1;
    let renderSequence = 0;

    const resultLinks = (): HTMLAnchorElement[] => [...list.querySelectorAll<HTMLAnchorElement>('a')];

    const closeResults = (): void => {
      panel.hidden = true;
      input.setAttribute('aria-expanded', 'false');
      input.removeAttribute('aria-activedescendant');
      activeIndex = -1;
    };

    const setActive = (nextIndex: number): void => {
      if (panel.hidden) return;
      const links = resultLinks();
      if (links.length === 0) return;
      activeIndex = activeIndex < 0
        ? (nextIndex < 0 ? links.length - 1 : 0)
        : (nextIndex + links.length) % links.length;
      links.forEach((link, index) => {
        const selected = index === activeIndex;
        link.setAttribute('aria-selected', String(selected));
        link.classList.toggle('docs-search__result--active', selected);
      });
      const active = links[activeIndex];
      input.setAttribute('aria-activedescendant', active.id);
      active.scrollIntoView({ block: 'nearest' });
    };

    const renderResults = async (): Promise<void> => {
      const rawQuery = input.value.trim();
      const query = normalizeText(rawQuery);
      if (!query) {
        renderSequence += 1;
        closeResults();
        status.textContent = '';
        list.replaceChildren();
        return;
      }

      const sequence = ++renderSequence;
      panel.hidden = false;
      input.setAttribute('aria-expanded', 'true');
      input.removeAttribute('aria-activedescendant');
      activeIndex = -1;
      status.textContent = root.dataset.loading ?? '';
      list.replaceChildren();

      try {
        const terms = query.split(/\s+/u).filter(Boolean);
        const index = await loadSearchIndex();
        if (sequence !== renderSequence) return;
        const matches = index
          .filter((doc) => doc.locale === locale)
          .map((doc) => ({ doc, score: scoreDocument(doc, query, terms) }))
          .filter((item) => item.score >= 0)
          .sort((a, b) => b.score - a.score || a.doc.title.localeCompare(b.doc.title))
          .slice(0, 8);

        if (matches.length === 0) {
          status.textContent = root.dataset.empty ?? '';
          return;
        }

        status.textContent = `${matches.length} ${root.dataset.count ?? ''}`;
        matches.forEach(({ doc }, index) => {
          const item = document.createElement('li');
          item.className = 'docs-search__item';
          item.setAttribute('role', 'none');

          const link = document.createElement('a');
          link.id = `${input.id}-result-${index}`;
          link.className = 'docs-search__result';
          link.href = doc.href;
          link.setAttribute('role', 'option');
          link.setAttribute('aria-selected', 'false');

          const title = document.createElement('strong');
          title.className = 'docs-search__result-title';
          appendHighlighted(title, doc.title, terms);

          const snippet = document.createElement('span');
          snippet.className = 'docs-search__result-snippet';
          appendHighlighted(snippet, makeSnippet(doc, query, terms), terms);

          link.append(title, snippet);
          item.append(link);
          list.append(item);
        });
      } catch {
        if (sequence !== renderSequence) return;
        status.textContent = root.dataset.error ?? '';
      }
    };

    input.addEventListener('input', () => void renderResults());
    input.addEventListener('focus', () => {
      if (input.value.trim()) void renderResults();
    });
    input.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowDown') {
        event.preventDefault();
        setActive(activeIndex + 1);
      } else if (event.key === 'ArrowUp') {
        event.preventDefault();
        setActive(activeIndex - 1);
      } else if (event.key === 'Enter' && !panel.hidden && activeIndex >= 0) {
        event.preventDefault();
        resultLinks()[activeIndex]?.click();
      } else if (event.key === 'Escape') {
        closeResults();
        input.blur();
      }
    });

    document.addEventListener('click', (event) => {
      if (!root.contains(event.target as Node)) closeResults();
    });
    root.addEventListener('focusout', () => {
      setTimeout(() => {
        if (!root.contains(document.activeElement)) closeResults();
      }, 0);
    });
    document.addEventListener('keydown', (event) => {
      const target = event.target as HTMLElement | null;
      const isEditable = target?.matches('input, textarea, select, [contenteditable="true"]');
      const isShortcut = (event.key === '/' && !isEditable)
        || ((event.ctrlKey || event.metaKey) && event.key.toLowerCase() === 'k');
      if (!isShortcut) return;
      event.preventDefault();
      input.focus();
      input.select();
    });
  });
</script>
